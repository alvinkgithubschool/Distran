# Backend only: copy this file to backend/.env and fill the values there.
# Never place provider credentials in a VITE_* variable or the Tauri bundle.
TMDB_READ_TOKEN=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Optional local persistent cache override; default backend/data/catalog.sqlite3
CATALOG_CACHE_PATH=
# Future hosted services (not required for catalog reads)
DATABASE_URL=
WORKOS_CLIENT_ID=
WORKOS_ISSUER=
WORKOS_JWKS_URL=
# Buddy uses ONLY the two approved :free models through OpenRouter.
OPENROUTER_API_KEY=
BUDDY_ENABLED=false
